# ========================================================
# Daily Task Manager - Frontend Environment Variables
# ========================================================

# Base URL of the deployed Spring Boot backend on Render
# In local development, you can leave this empty to use Vite's dev proxy
# For Vercel production deployment, set this to your Render service URL:
# Example: https://daily-task-manager-backend.onrender.com
VITE_API_BASE_URL=https://your-render-backend-url.onrender.com
